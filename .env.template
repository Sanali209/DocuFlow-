# --- DocuFlow Unified SDK Configuration ---

# Unique ID for this terminal node (e.g. LASER_01, OFFICE_02)
NODE_ID=node_01

# Application Settings
APP_NAME=DocuFlow
DEBUG=true
LOG_LEVEL=INFO

# Network Storage Configuration (Samba/NFS)
# This folder is shared between all nodes in the cluster.
SHARED_PATH=./shared_network

# Local Database Configuration
DATABASE_URL=sqlite:///./local.db

# Distributed Coordination & Orchestration (Seconds)
HEARTBEAT_INTERVAL=15
COORDINATOR_TIMEOUT=45
BUS_POLL_INTERVAL=5
SYNC_CHECK_INTERVAL=60
GC_INTERVAL=3600

# Security (Change in production!)
STORAGE_SECRET=docuflow_secret_change_me
